# ASA Conecta — Portal web. Copie para .env.local se precisar sobrescrever.
# Somente configuração PÚBLICA: nunca coloque segredos em variáveis VITE_* (vão para o navegador).

# API Node.js para onde o servidor de desenvolvimento/preview do Vite repassa /api e /health
VITE_API_PROXY_TARGET=http://localhost:3000
# Porta do servidor de desenvolvimento (a API aceita cookies desta origem: WEB_ORIGINS na API)
WEB_PORT=5173
