{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asa-conecta.local/contracts/agent/student-agent-response.v1.json",
  "title": "StudentAgentResponse v1",
  "description": "Resposta do Python Agent Service para a API Node.js. Versao 1.x. O consumidor rejeita qualquer versao com major diferente de 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "request_id", "correlation_id", "run_id", "agent", "agent_version", "config_version",
    "status", "summary", "recommendations", "confidence", "requires_human_validation", "abstained", "abstention_reason", "evaluated_at"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "request_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "run_id": { "type": "string", "pattern": "^run-" },
    "agent": { "type": "string", "const": "student_agent" },
    "agent_version": { "type": "string" },
    "config_version": { "type": "string" },
    "status": { "type": "string", "enum": ["recommendation", "no_action", "abstained"] },
    "summary": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "message", "evidence", "next_action", "confidence", "requires_human_validation", "priority", "subject_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^rec-" },
          "type": { "type": "string" },
          "message": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "source_reference"],
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "source_reference": { "type": ["string", "null"] }
              }
            }
          },
          "next_action": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "requires_human_validation": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 1 },
          "subject_id": { "type": ["string", "null"] }
        }
      }
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "requires_human_validation": { "type": "boolean" },
    "abstained": { "type": "boolean" },
    "abstention_reason": { "type": ["string", "null"] },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}
