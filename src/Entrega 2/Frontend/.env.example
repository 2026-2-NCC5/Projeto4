# ASA Conecta - app mobile (Expo). Copie para .env e ajuste. NUNCA versione o .env.
#
# URL base da API Node.js (src/Entrega 2/Backend/api). Deixe vazio para derivar automaticamente
# do host do Metro (Expo Go no celular usa o IP da sua máquina na porta 3000).
# Exemplos:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#   EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=

# Timeout (ms) das chamadas comuns à API (perfil, disciplinas, histórico...)
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Timeout (ms) da análise do agente (POST /api/agent/analyze), que é mais lenta
EXPO_PUBLIC_ANALYSIS_TIMEOUT_MS=15000

# ---------------------------------------------------------------- assistente por voz
# Liga o modo "Conversar" (voz + texto) na aba Assistente. false = apenas "Análise completa".
EXPO_PUBLIC_VOICE_ASSISTANT_ENABLED=true

# Entrada por voz: "device" usa o serviço de voz do sistema (expo-speech-recognition;
# exige development build no celular, Chrome/Safari no web). "none" desativa só o microfone.
EXPO_PUBLIC_SPEECH_PROVIDER=device

# Idioma do reconhecimento e da resposta falada (BCP-47)
EXPO_PUBLIC_SPEECH_LANGUAGE=pt-BR

# true = exige reconhecimento no próprio aparelho (o áudio não vai para servidores do
# fabricante). Pode deixar a voz indisponível em aparelhos sem o pacote de idioma offline.
EXPO_PUBLIC_SPEECH_ON_DEVICE_ONLY=false

# Valor inicial da preferência "Resposta por voz" (o aluno pode mudar no Perfil)
EXPO_PUBLIC_TTS_ENABLED_DEFAULT=true

# Timeout (ms) de POST /api/assistant/message
EXPO_PUBLIC_ASSISTANT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- "Hey Asa" (ativação por voz)
# Disponibiliza a ativação por voz no app. A preferência do aluno (Perfil → Assistente ASA) decide se
# ela roda; nasce desligada. Só funciona em primeiro plano e em development build / web (não no Expo Go).
EXPO_PUBLIC_WAKE_WORD_ENABLED=true

# Disponibiliza "Interromper por voz" (barge-in experimental, opt-in do aluno)
EXPO_PUBLIC_BARGE_IN_ENABLED=true
