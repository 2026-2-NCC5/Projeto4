# Variáveis da observabilidade e do teste de carga (ambiente LOCAL). Copie para observability/.env,
# que o .gitignore da raiz ignora, e troque todos os valores. Gere segredos com: openssl rand -base64 36
#
# Token que o Prometheus envia em GET /metrics (mínimo 24 caracteres; sem ele a rota responde 404)
METRICS_TOKEN=
# Senha do usuário admin do Grafana (http://127.0.0.1:3300)
GRAFANA_ADMIN_PASSWORD=
# Token entre a API e o serviço do agente (o agente recusa chamadas sem ele)
AGENT_SERVICE_TOKEN=
# Senha das contas de teste carga.NN@edu.fecap.br criadas pelo k6 no banco local
# (maiúscula, minúscula, número e símbolo; mínimo 8)
LOAD_TEST_PASSWORD=
JWT_SECRET=
CRON_SECRET=

# Limites dos contêineres (cgroups). A API recebe 1 vCPU, como uma instância de função na nuvem.
API_CPUS=1.0
API_MEMORY=1g
AGENT_CPUS=1.0
AGENT_MEMORY=512m
AGENT_SERVICE_WORKERS=1
DB_CPUS=1.0
DB_MEMORY=1g
DATABASE_POOL_MAX=10

# Mesmo modo de dados da produção (institucional, sem dados fictícios)
APP_ENV=production
NODE_ENV=production
DEMO_DATA_ENABLED=false
DEMO_SEED_ENABLED=false
ACADEMIC_DATA_PROVIDER=institutional
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Usuário que grava os resultados do k6 (id -u / id -g)
K6_UID=1000
K6_GID=1000
