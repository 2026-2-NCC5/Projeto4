# ASA Conecta — variáveis do docker-compose (todas com defaults de desenvolvimento).
# Copie para .env se quiser sobrescrever. NUNCA versione o .env.
POSTGRES_USER=asa
POSTGRES_PASSWORD=asa_dev_password
POSTGRES_DB=asa_conecta
POSTGRES_PORT=5432
# Banco online (Supabase, projeto "ASA Conecta"): descomente e troque [SENHA] pela senha do banco.
# Com esta variável a API do Compose ignora o serviço `db` local. Detalhes em database/README.md.
# DATABASE_URL=postgresql://postgres.lxfssnqxsxiywfndsfdn:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=auto
API_PORT=3000
AGENT_SERVICE_PORT=8000
JWT_SECRET=troque-este-segredo-local-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TTL_HOURS=12
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
SIGNUP_ALLOWED_EMAIL_DOMAINS=edu.fecap.br,fecap.br,demo.asa
STUDENT_EMAIL_DOMAIN=edu.fecap.br
STAFF_EMAIL_DOMAIN=fecap.br
GAMEFY_SUPABASE_URL=
GAMEFY_SUPABASE_SERVICE_ROLE_KEY=
GAMEFY_INSTITUTION_SLUG=fecap
BIOMETRIC_LOGIN_ENABLED=true
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
AGENT_SERVICE_TIMEOUT_MS=5000
LOG_LEVEL=info
AGENT_LOG_LEVEL=INFO
CORS_ORIGIN=*
VOICE_ASSISTANT_ENABLED=true
INTENT_MIN_CONFIDENCE=0.6
APP_TIMEZONE=America/Sao_Paulo
# Fila presencial do ASA: somente fonte oficial real. Se a fonte negar acesso, o recurso fica indisponível; sem dados sintéticos.
ASA_QUEUE_ENABLED=true
ASA_QUEUE_PROVIDER=fecap
ASA_QUEUE_SOURCE_AUTHORIZED=false
ASA_QUEUE_ALLOW_PUBLIC_SCRAPING=false
ASA_QUEUE_SOURCE_URL=https://presencial.fecap.br/
ASA_QUEUE_POLL_INTERVAL_SECONDS=30
ASA_QUEUE_CACHE_TTL_SECONDS=30
# Push: expo | log (só registra no log) | disabled. EXPO_ACCESS_TOKEN só com "Enhanced Security for Push".
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# ---- Plataforma (ver api/.env.example para a explicação de cada variável)
APP_ENV=development
# 1 = demonstração (dados fictícios); 0 = somente os dados reais do banco configurado em DATABASE_URL.
DEMO_DATA_ENABLED=0
DEMO_SEED_ENABLED=false
ACADEMIC_DATA_PROVIDER=institutional
AUTOMATION_SCAN_INTERVAL_SECONDS=300
# Portal web do Compose (nginx): http://localhost:8080
WEB_HTTP_PORT=8080
WEB_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
WEB_COOKIE_SECURE=auto
AI_PROVIDER=existing
JEV_ENABLED=false
# ---- Execução fora do Docker / Vercel (ver docs/migration/05-variaveis-ambiente.md)
DATABASE_POOL_MAX=10
AGENT_SERVICE_TOKEN=
CRON_SECRET=
# ---- Central de Atendimento WhatsApp (docs/whatsapp/README.md; descrição de cada variável em api/.env.example)
ASA_WHATSAPP_PROVIDER=none
ASA_WHATSAPP_OUTBOUND_ENABLED=false
ASA_WHATSAPP_SESSION_MANAGEMENT_ENABLED=false
ASA_SUPPORT_MIRROR_WHATSAPP_TO_APP=false
ASA_WHATSAPP_PII_KEY=
ASA_WHATSAPP_WEBHOOK_SECRET=
ASA_SUPPORT_PUBLIC_BASE_URL=
# docker-compose.whatsapp-pilot.yml: só com autorização formal do número
WA_AKG_AUTH_SECRET=
WA_AKG_ENCRYPTION_KEY=
WA_AKG_MYSQL_ROOT_PASSWORD=
WA_AKG_ADMIN_EMAIL=
WA_AKG_ADMIN_PASSWORD=
