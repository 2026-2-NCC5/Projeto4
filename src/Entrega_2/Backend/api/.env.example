# ASA Conecta - API principal (Node.js). Copie para .env e ajuste. NUNCA versione o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL local (docker compose usa asa/asa_dev_password@localhost:5432/asa_conecta)
DATABASE_URL=postgres://asa:asa_dev_password@localhost:5432/asa_conecta
# Banco online (Supabase, projeto "ASA Conecta"): troque [SENHA] pela senha do banco
# (Dashboard > Project Settings > Database). Use o pooler em modo sessao (porta 5432);
# a conexao direta db.<ref>.supabase.co e somente IPv6. Detalhes em database/README.md.
# DATABASE_URL=postgresql://postgres.lxfssnqxsxiywfndsfdn:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# TLS: auto (remoto = TLS, local = sem TLS) | require | disable. Com DATABASE_SSL_CA_FILE
# (certificado raiz do Supabase em PEM) a cadeia e verificada.
DATABASE_SSL=auto
DATABASE_SSL_CA_FILE=
# Conexoes por instancia. Na Vercel cada instancia da funcao tem o seu pool: use 3 (o pooler do Supabase
# limita as conexoes do projeto). Processo unico (npm start, Docker): 10.
DATABASE_POOL_MAX=10
# db:reset apaga o schema inteiro; em bancos remotos exige true explicitamente
ALLOW_REMOTE_DB_RESET=false

# Banco DESCARTAVEL usado pelos testes de integracao/E2E (o schema e recriado a cada execucao)
TEST_DATABASE_URL=postgres://asa:asa_dev_password@localhost:5432/asa_conecta_test

# JWT (troque em qualquer ambiente que nao seja local; minimo 32 caracteres)
JWT_SECRET=troque-este-segredo-local-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=15m

# Sessao: "Manter conectado" (dias) e sessao curta sem "Manter conectado" (horas)
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TTL_HOURS=12

# Protecao contra abuso (limites por IP e bloqueio por tentativas de login)
RATE_LIMIT_ENABLED=true
# false | true | loopback | numero de proxies confiaveis (so ative atras de proxy reverso).
# Em branco: true na Vercel (o proxy dela sobrescreve X-Forwarded-For com o IP real), false fora dela.
TRUST_PROXY=

# Cadastro
SIGNUP_ALLOWED_EMAIL_DOMAINS=edu.fecap.br,fecap.br,demo.asa
REGISTRATION_NUMBER_PATTERN=^\d{8}$
REGISTRATION_NUMBER_EXAMPLE=24026962
# URLs publicas dos documentos (deixe em branco se nao existirem; o app nao mostra links falsos)
TERMS_URL=
PRIVACY_URL=

# Recuperacao de senha por codigo enviado por e-mail
RESET_CODE_LENGTH=6
RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RESET_RESEND_COOLDOWN_SECONDS=60
RESET_MAX_SENDS=5
RESET_TOKEN_TTL_MINUTES=15

# E-mail: smtp (Mailpit local: docker compose up -d mailpit) ou disabled (recuperacao indisponivel)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ASA Conecta <nao-responda@asa-conecta.local>

# Biometria (credencial de dispositivo)
BIOMETRIC_LOGIN_ENABLED=true
BIOMETRIC_CREDENTIAL_TTL_DAYS=30

# Agent Service (Python/FastAPI)
# Obrigatoria com NODE_ENV=production. Na Vercel vem do binding do servico `agent` (nao cadastre).
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TIMEOUT_MS=5000
# Segredo compartilhado com o Agent Service (o mesmo valor la). Em branco = sem exigencia (rede interna).
AGENT_SERVICE_TOKEN=

# CORS (origens separadas por virgula; * libera para desenvolvimento com Expo)
CORS_ORIGIN=*

# Assistente conversacional (voz/texto) — POST /api/assistant/message
VOICE_ASSISTANT_ENABLED=true
# Confiança mínima para executar uma intenção interpretada (0 a 1)
INTENT_MIN_CONFIDENCE=0.6
# Fuso usado para "hoje", "esta semana" e prazos nas respostas
APP_TIMEZONE=America/Sao_Paulo

# Fila presencial do ASA (https://presencial.fecap.br/) — UM monitor no backend consulta a fonte
# e distribui o estado para todos os alunos (nunca uma consulta por aluno).
ASA_QUEUE_ENABLED=true
# mock (padrão): simulador identificado como DEMONSTRAÇÃO | fecap: painel público (JSON com fallback HTML)
# | fecap-html: só HTML. O painel público só deve ser consultado com autorização da FECAP: registre-a em
# ASA_QUEUE_SOURCE_AUTHORIZED=true (sem isso os clientes mostram "fonte sem autorização institucional").
# Em produção, sem provedor explícito a fila fica desligada (nunca simulada); mock é recusado.
ASA_QUEUE_PROVIDER=mock
ASA_QUEUE_SOURCE_AUTHORIZED=false
ASA_QUEUE_SOURCE_URL=https://presencial.fecap.br/
# Intervalo entre consultas (mínimo 5 s); falhas usam backoff exponencial até o máximo
ASA_QUEUE_POLL_INTERVAL_SECONDS=10
ASA_QUEUE_MAX_BACKOFF_SECONDS=300
# Falhas seguidas até abrir o circuito (consultas passam a usar o intervalo máximo)
ASA_QUEUE_FAILURE_THRESHOLD=5
ASA_QUEUE_REQUEST_TIMEOUT_MS=8000
# Snapshot mais velho que isto aparece como desatualizado; seguidores (várias instâncias) releem o banco neste ritmo
ASA_QUEUE_CACHE_TTL_SECONDS=30
# Cadastros de senha por usuário a cada 10 minutos
ASA_QUEUE_SUBSCRIPTION_RATE_LIMIT=10
# Só com ASA_QUEUE_PROVIDER=mock: empty | waiting | 5_ahead | 3_ahead | next | called | completed | offline | progression
ASA_QUEUE_MOCK_SCENARIO=progression
ASA_QUEUE_MOCK_STEP_SECONDS=20
# Duracao de cada conexao de tempo real (SSE); o app reconecta. Em branco: 240 na Vercel (limite da funcao: 300 s), 300 fora
ASA_QUEUE_STREAM_MAX_SECONDS=

# Notificações push (Expo Push Service → APNs/FCM): expo | log (desenvolvimento: só registra) | disabled
PUSH_PROVIDER=expo
# Opcional, segredo do backend: só quando "Enhanced Security for Push" está ativo no projeto Expo
EXPO_ACCESS_TOKEN=
# Atraso até conferir os recibos de entrega (0 desativa)
PUSH_RECEIPT_DELAY_SECONDS=60

# ---- Plataforma (portal web, modo demonstração, recursos) -------------------------------------------
# Ambiente exibido nos clientes: development | test | staging | demo | production (padrão: derivado de NODE_ENV)
APP_ENV=development
# Modo de dados: 1 = demonstração (permite contas e dados fictícios); 0 = somente dados reais do banco.
# A conexão do banco é definida em DATABASE_URL; a API nunca escolhe um banco pelo cliente.
DEMO_DATA_ENABLED=1
# Seeds fictícios (database/seeds): nunca em produção; banco remoto só com DEMO_SEED_ALLOW_REMOTE=true
DEMO_SEED_ENABLED=true
DEMO_SEED_ALLOW_REMOTE=false
DEMO_SCENARIO=academic-full
# Fonte acadêmica: demo (seed fictício) | institutional (TOTVS/Portal do Aluno — não configurada: responde 503)
ACADEMIC_DATA_PROVIDER=demo
# Recursos (a administração também pode desligar em Configurações → Recursos ativos)
FEATURE_TICKETS_ENABLED=true
FEATURE_APPOINTMENTS_ENABLED=true
FEATURE_KB_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_REALTIME_ENABLED=false
# Varredura dos prazos para as automações, em segundos (0 desliga). As regras nascem desligadas.
# Vale para o processo residente (npm start, npm run worker). Na Vercel: Cron em /api/internal/jobs/sla-scan.
AUTOMATION_SCAN_INTERVAL_SECONDS=300
# Segredo das rotas /api/internal/jobs/* (Vercel Cron envia Authorization: Bearer <CRON_SECRET>).
# Em branco: rotas desativadas (404). Gere com: openssl rand -hex 32
CRON_SECRET=
# Tamanho máximo de cada anexo de chamado (bytes). Em branco: 3 MiB na Vercel (corpo da função: 4,5 MB), 5 MiB fora
SUPPORT_MAX_ATTACHMENT_BYTES=
# Portal web: origens aceitas nas requisições com cookie de sessão (CSRF). Inclua a URL pública em produção.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# auto: cookies Secure só com NODE_ENV=production (HTTPS) | true | false
WEB_COOKIE_SECURE=auto
# Provedor de IA do assistente: existing (regras + base de conhecimento) | jev (integração futura).
# JEV continua desligado até existir contrato técnico e autorização (ver JEV_INTEGRATION_ADR.md).
AI_PROVIDER=existing
JEV_ENABLED=false
