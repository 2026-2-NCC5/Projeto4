FECAP_PORTAL_URL=https://portal.fecap.br/framehtml/web/app/edu/PortalEducacional/#/
FECAP_USERNAME=
FECAP_PASSWORD=
FECAP_AUTH_MODE=auto
FECAP_BROWSER_HEADLESS=false
FECAP_SESSION_PERSIST=false
FECAP_SESSION_STORAGE_PATH=.private/fecap-session.enc
FECAP_CRAWL_MODE=read_only
FECAP_MAX_CONCURRENT_PAGES=1
FECAP_REQUEST_DELAY_MS=1500
FECAP_MAX_RETRIES=3
FECAP_TIMEOUT_MS=30000
FECAP_DOWNLOAD_DOCUMENTS=false
FECAP_SYNC_ENABLED=false
FECAP_SYNC_INTERVAL_MINUTES=60
FECAP_CAPTURE_SCREENSHOTS=false
FECAP_DATA_DIR=.private/fecap-data
FECAP_LOG_LEVEL=INFO

# Emitido pelo ASA Conecta para o estudante autenticado; token escopado e revogável.
ASA_API_BASE_URL=
ASA_INTERNAL_SYNC_TOKEN=
