# Portal web do ASA Conecta (nginx). ${API_UPSTREAM} é substituído na subida do container.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 8m;

  include /etc/nginx/snippets/security-headers.conf;

  # API (mesma origem). Respostas da API já vêm com Cache-Control: no-store.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # eventos em tempo real da fila (SSE): sem buffer e com conexão longa
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location = /health {
    proxy_pass ${API_UPSTREAM};
  }

  # arquivos com hash no nome: cache longo
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: rotas do cliente voltam para o index.html (sempre revalidado)
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
